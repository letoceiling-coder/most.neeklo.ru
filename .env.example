# ---- VPS server (packages/server) ----
SERVER_PORT=3030
SERVER_HOST=0.0.0.0
# Public base URL of the API (used in webhook signatures / dashboard)
PUBLIC_URL=https://most.neeklo.ru

# PostgreSQL connection
DATABASE_URL=postgres://most:most@localhost:5432/most

# Operator (dashboard) login
OPERATOR_USER=admin
OPERATOR_PASSWORD=change-me
# Secret used to sign operator session tokens
SESSION_SECRET=change-me-too

# Shared secret that PC agents must present (per-PC tokens are derived from it)
AGENT_SHARED_SECRET=change-me-agent

# OpenRouter (message processing)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
